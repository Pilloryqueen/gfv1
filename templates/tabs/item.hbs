<section
  class="tab sheet-body {{tab.active}}"
  data-tab="{{tab.id}}"
  data-group="{{tab.group}}"
>
  {{#if (defined system.tooltip)}}
    <div>
      <label>{{localize "GFv1.item.tooltip"}}</label>
      {{formInput
        systemFields.tooltip
        value=system.tooltip
        disabled=(not editable)
      }}
    </div>
  {{/if}}
  {{#if (eq item.type "playbook")}}
    {{#if (eq items.length 0)}}
      <p>{{localize "GFv1.item.playbook.dragMoreItems"}}</p>
    {{else}}
      <div class="item-list-group">
        {{#if (not assets.empty)}}{{render assets reorder=false}}{{/if}}
        {{#if (not bonds.empty)}}{{render bonds reorder=false}}{{/if}}
        {{#if (not identities.empty)}}{{render identities reorder=false}}{{/if}}
        {{#if (not rules.empty)}}{{render rules reorder=false}}{{/if}}
        {{#if (not strains.empty)}}{{render strains reorder=false}}{{/if}}
      </div>
    {{/if}}
  {{else if (eq item.type "rule")}}
    <div>
      <label>{{localize "GFv1.item.rule.play"}}</label>
      {{formInput systemFields.play value=system.play disabled=(not editable)}}
    </div>
    {{#if (eq system.play true)}}
      <section class="play-fields">
        <div>
          <label>{{localize "GFv1.item.rule.when"}}</label>
          {{formInput
            systemFields.when
            value=system.when
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.then"}}</label>
          {{formInput
            systemFields.then
            value=system.then
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.condition"}}</label>
          {{formInput
            systemFields.condition
            value=system.condition
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.heat"}}</label>
          {{formInput
            systemFields.heat
            value=system.heat
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.bonus"}}</label>
          {{formInput
            systemFields.bonus
            value=system.bonus
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.med"}}</label>
          {{formInput
            systemFields.med
            value=system.med
            disabled=(not editable)
          }}
        </div>
        <div>
          <label>{{localize "GFv1.item.rule.high"}}</label>
          {{formInput
            systemFields.high
            value=system.high
            disabled=(not editable)
          }}
        </div>
        <label>{{localize "GFv1.item.rule.low"}}</label>
        {{formInput systemFields.low value=system.low disabled=(not editable)}}
        <div>
          <label>Preview:</label>
          {{partial "playDescription" system=system}}
          {{partial "playResult" system=system}}
        </div>
      </section>
    {{/if}}
  {{else}}
    <div class="item-properties">
      {{#each item.system.properties as |property|}}
        <div class="item-property">
          <label>{{property.label}}</label>
          {{formInput
            property.field
            value=property.value
            localize=true
            disabled=(not @root/editable)
          }}
        </div>
      {{/each}}
    </div>
  {{/if}}
</section>