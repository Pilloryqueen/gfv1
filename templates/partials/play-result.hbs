{{#if system.play}}
  <section class="play-result">
    <div class="result-line {{ifThen (eq result 'med') 'active' ''}}">
      <label class="roll-med">{{localize "GFv1.item.rule.med"}}</label>
      <span>{{{system.med}}}</span>
    </div>
    <div class="result-line {{ifThen (eq result 'high') 'active' ''}}">
      <label class="roll-high">{{localize "GFv1.item.rule.high"}}</label>
      <span>{{{system.high}}}</span>
    </div>
    <div class="result-line {{ifThen (eq result 'low') 'active' ''}}">
      <label class="roll-low">{{localize "GFv1.item.rule.low"}}</label>
      <span>{{{system.low}}}</span>
    </div>
  </section>
{{/if}}