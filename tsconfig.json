{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "types": ["fvtt-types"],
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "vite.config.mts", "gfv1.js"]
}
